<IfModule mod_headers.c>
    Header always set Permissions-Policy "publickey-credentials-get=(), identity-credentials-get=()"

    # Aset Vite bernama hash (nama-AbCd1234.js/.css): isinya tak pernah berubah
    # untuk nama yang sama, jadi boleh disimpan setahun tanpa ditanya ulang.
    # Menghemat permintaan di HP & koneksi pabrik yang lambat.
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # PDF.js (berkas besar, jarang diganti): 30 hari.
    <FilesMatch "^(pdf\.min|pdf\.worker\.min|qc-pdf-viewer)\.js$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Service worker & manifest jangan di-cache: perbaikan harus langsung sampai.
    <FilesMatch "^(sw\.js|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    Options +FollowSymLinks
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve uploaded files from storage/app/public (fallback for hosting without symlink)
    RewriteCond %{REQUEST_URI} !storage/app/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^storage/(.+)$ ../storage/app/public/$1 [L,NC]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
